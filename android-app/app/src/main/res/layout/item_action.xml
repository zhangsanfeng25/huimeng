<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="18dp"
    app:cardElevation="0dp" app:strokeColor="@color/line_soft" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="13dp">
        <ImageView android:id="@+id/cover" android:layout_width="66dp"
            android:layout_height="84dp" android:contentDescription="商品封面"
            android:scaleType="centerCrop" android:visibility="gone" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="2"
                android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/subtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/action"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
            android:layout_height="44dp" android:layout_marginStart="8dp" android:minWidth="76dp"
            android:textSize="13sp" android:insetBottom="0dp" android:insetTop="0dp"
            app:cornerRadius="14dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
