<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/auth_cream" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="20dp">
    <FrameLayout android:id="@+id/heroFrame" android:layout_width="match_parent" android:layout_height="244dp">
      <ImageView android:id="@+id/forestHero" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/login_forest_user" android:importantForAccessibility="no" />
      <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/auth_hero_tint" android:importantForAccessibility="no" />
      <View android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="bottom" android:background="@drawable/bg_forest_fade" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/authContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="绘梦书城" android:textColor="@color/auth_ink" android:textSize="30sp" android:textStyle="bold" />
      <TextView android:id="@+id/roleTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="用户登录" />
      <TextView android:id="@+id/roleSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="让每一个孩子与好故事相遇" android:textColor="@color/auth_muted" android:textSize="13sp" />
      <FrameLayout android:id="@+id/roleTabs" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/bg_forest_tabs" android:padding="2dp">
        <View android:id="@+id/roleIndicator" android:layout_width="0dp" android:layout_height="match_parent" android:background="@drawable/bg_forest_selected" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
          <TextView android:id="@+id/buyerTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="用户登录" android:textSize="15sp" android:textStyle="bold" android:clickable="true" android:focusable="true" android:contentDescription="切换到用户登录" />
          <TextView android:id="@+id/merchantTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="商家登录" android:textSize="15sp" android:textStyle="bold" android:clickable="true" android:focusable="true" android:contentDescription="切换到商家登录" />
        </LinearLayout>
      </FrameLayout>
      <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:hintEnabled="false" app:boxBackgroundMode="filled" app:boxBackgroundColor="@color/auth_field" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="1dp" app:startIconDrawable="@drawable/ic_user">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/accountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:inputType="text" android:singleLine="true" android:hint="账号 / 邮箱 / 手机号" android:textColorHint="@color/auth_muted" android:textSize="15sp" android:textColor="@color/auth_ink" android:imeOptions="actionNext" android:autofillHints="username" />
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:hintEnabled="false" app:boxBackgroundMode="filled" app:boxBackgroundColor="@color/auth_field" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="1dp" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:inputType="textPassword" android:singleLine="true" android:hint="密码" android:textColorHint="@color/auth_muted" android:textSize="15sp" android:textColor="@color/auth_ink" android:imeOptions="actionDone" android:autofillHints="password" />
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/rememberLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="false" android:text="记住登录" android:textColor="@color/auth_muted" android:textSize="13sp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="4dp" android:text="登录" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" app:backgroundTint="@color/auth_green" app:cornerRadius="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/register" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:gravity="start|center_vertical" android:text="注册新账号" android:textColor="@color/auth_accent" android:textSize="14sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/forgotPassword" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:gravity="end|center_vertical" android:text="忘记密码？" android:textColor="@color/auth_accent" android:textSize="14sp" android:clickable="true" android:focusable="true" />
      </LinearLayout>
      <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/auth_error" android:accessibilityLiveRegion="polite" />
      <TextView android:id="@+id/roleSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:text="向左滑动，切换商家登录  →" android:textColor="@color/auth_muted" android:textSize="12sp" android:clickable="true" android:focusable="true" />
      <TextView android:id="@+id/demoAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/auth_muted" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
