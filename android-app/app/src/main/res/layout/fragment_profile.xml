<?xml version="1.0" encoding="utf-8"?>
<com.huimeng.bookshop.ui.PullRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/milk_white" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我的" android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="18dp" android:background="@drawable/bg_profile_header" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
            <com.huimeng.bookshop.ui.AvatarImageView android:id="@+id/avatar" android:layout_width="76dp" android:layout_height="76dp" android:contentDescription="用户头像" android:src="@drawable/app_icon"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="绘梦会员 · 一起读更多好故事" android:textColor="@color/muted" android:textSize="13sp"/></LinearLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView app:cardBackgroundColor="@color/surface_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="我的订单" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/orders" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:text="全部订单  ›" android:textColor="@color/muted" android:textSize="13sp"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginTop="6dp" android:orientation="horizontal"><TextView android:id="@+id/pendingPayment" style="@style/ProfileShortcut" android:drawableTop="@drawable/ic_pay" android:drawablePadding="7dp" android:text="待付款"/><TextView android:id="@+id/pendingShipment" style="@style/ProfileShortcut" android:drawableTop="@drawable/ic_box" android:drawablePadding="7dp" android:text="待发货"/><TextView android:id="@+id/pendingReceipt" style="@style/ProfileShortcut" android:drawableTop="@drawable/ic_delivery" android:drawablePadding="7dp" android:text="待收货"/><TextView android:id="@+id/pendingReview" style="@style/ProfileShortcut" android:drawableTop="@drawable/ic_review" android:drawablePadding="7dp" android:text="待评价"/></LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView app:cardBackgroundColor="@color/surface_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp"><TextView android:id="@+id/cart" style="@style/ProfileMenu" android:drawableStart="@drawable/ic_cart" android:text="购物车"/><TextView android:id="@+id/favorites" style="@style/ProfileMenu" android:drawableStart="@drawable/ic_heart" android:text="我的收藏"/><TextView android:id="@+id/addresses" style="@style/ProfileMenu" android:drawableStart="@drawable/ic_location" android:text="收货地址"/><TextView android:id="@+id/settings" style="@style/ProfileMenu" android:drawableStart="@drawable/ic_palette" android:text="外观与壁纸设置"/><TextView android:id="@+id/merchantApplication" style="@style/ProfileMenu" android:drawableStart="@drawable/ic_switch" android:text="商家申请与进度"/><TextView android:id="@+id/editAccount" style="@style/ProfileMenu" android:drawableStart="@drawable/ic_user" android:text="编辑账户"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/logout" style="@style/Widget.HuiMeng.LogoutButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:text="退出登录" app:cornerRadius="17dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

</com.huimeng.bookshop.ui.PullRefreshLayout>
