<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="孩子与小熊坐在绘本上，眺望月光下的故事世界"
        android:scaleType="centerCrop"
        android:src="@drawable/welcome_storybook_night" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="76dp"
        android:paddingEnd="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="绘梦书城"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="让好故事，陪伴每一次成长"
            android:textColor="#E6E7F8"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_welcome_skip"
        android:contentDescription="跳过欢迎页"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="跳过"
        android:textColor="#1F294D"
        android:textSize="16sp"
        android:textStyle="bold" />
</FrameLayout>
