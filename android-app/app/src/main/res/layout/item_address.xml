<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="18dp" app:strokeColor="@color/line_soft" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/recipient" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/muted" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/edit" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end" android:layout_marginTop="8dp" android:text="修改内容" app:cornerRadius="14dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
