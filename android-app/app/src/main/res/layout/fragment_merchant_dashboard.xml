<?xml version="1.0" encoding="utf-8"?>
<com.huimeng.bookshop.ui.PullRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/milk_white">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="商家工作台" android:textColor="@color/ink" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="需要你处理" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/todoShip" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="88dp" android:layout_weight="1" android:text="—&#10;待发货" android:textSize="17sp" android:textColor="@color/cool_green_dark" android:backgroundTint="@color/surface_card" app:strokeColor="@color/line_soft" app:cornerRadius="18dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/todoSale" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="88dp" android:layout_marginStart="12dp" android:layout_weight="1" android:text="—&#10;待处理售后" android:textSize="17sp" android:textColor="@color/cool_green_dark" android:backgroundTint="@color/surface_card" app:strokeColor="@color/line_soft" app:cornerRadius="18dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/todoProducts" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="88dp" android:layout_weight="1" android:text="—&#10;商品待修改 / 提交" android:textSize="15sp" android:textColor="@color/cool_green_dark" android:backgroundTint="@color/surface_card" app:strokeColor="@color/line_soft" app:cornerRadius="18dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/todoMessages" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="88dp" android:layout_marginStart="12dp" android:layout_weight="1" android:text="—&#10;未读消息" android:textSize="17sp" android:textColor="@color/cool_green_dark" android:backgroundTint="@color/surface_card" app:strokeColor="@color/line_soft" app:cornerRadius="18dp" />
            </LinearLayout>
            <TextView android:id="@+id/dataHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="下拉刷新待办与经营数据" android:textColor="@color/muted" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/newProduct" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:text="＋ 新增商品" android:textSize="16sp" app:cornerRadius="18dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="经营概况" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_search" android:padding="16dp" android:text="正在读取商品与订单数据…" android:lineSpacingExtra="6dp" android:textColor="@color/muted" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/allProducts" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:text="全部商品" />
                <com.google.android.material.button.MaterialButton android:id="@+id/allOrders" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:text="全部订单" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.huimeng.bookshop.ui.PullRefreshLayout>
