<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_background" android:orientation="vertical" android:padding="18dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="center_vertical"><ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_search" android:contentDescription="返回" android:padding="10dp" android:src="@drawable/ic_back"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="阅读笔记" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/></LinearLayout>
 <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:indeterminateTint="@color/cool_green"/>
 <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical"><com.huimeng.bookshop.ui.AvatarImageView android:id="@+id/avatar" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="查看作者主页" android:src="@drawable/ic_avatar_placeholder"/><TextView android:id="@+id/author" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center_vertical" android:textColor="@color/cool_green_dark" android:textSize="14sp"/></LinearLayout>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/photos" android:layout_width="match_parent" android:layout_height="250dp" android:layout_marginTop="16dp" android:background="@color/surface_soft" android:contentDescription="阅读笔记图片，左右滑动切换" android:visibility="gone"/>
  <TextView android:id="@+id/photoIndicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/muted" android:textSize="13sp" android:visibility="gone"/>
  <TextView android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:lineSpacingExtra="6dp" android:textColor="@color/ink" android:textSize="16sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="大家的评论" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold"/><TextView android:id="@+id/commentCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="13sp"/></LinearLayout>
  <TextView android:id="@+id/emptyComments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:padding="20dp" android:text="还没有评论，来分享你的阅读感受吧" android:textColor="@color/muted" android:visibility="gone"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/comments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:nestedScrollingEnabled="false"/>
 </LinearLayout></androidx.core.widget.NestedScrollView>
 <LinearLayout android:id="@+id/commentComposer" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><EditText android:id="@+id/commentInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_search" android:hint="写下你的评论" android:paddingHorizontal="15dp" android:singleLine="true"/><com.google.android.material.button.MaterialButton android:id="@+id/send" android:layout_width="78dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:text="发送" app:cornerRadius="16dp"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="end|center_vertical" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/like" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="点赞阅读笔记" android:text="♡ 点赞" app:cornerRadius="24dp"/><com.google.android.material.button.MaterialButton android:id="@+id/commentToggle" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:contentDescription="展开评论输入框" android:text="✎ 评论" app:cornerRadius="24dp"/></LinearLayout>
</LinearLayout>
