<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_background" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="center_vertical"><ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_search" android:contentDescription="返回" android:padding="10dp" android:src="@drawable/ic_back"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="发布阅读笔记" android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold"/></LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="分享共读画面" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/imageHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="最多 9 张 · 选择后逐张裁剪 · 左右滑动预览" android:textColor="@color/muted" android:textSize="13sp"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="142dp" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="18dp" app:strokeColor="@color/line_soft" app:strokeWidth="1dp"><FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp"><TextView android:id="@+id/emptyImages" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="选中的图片会显示在这里\n可左右滑动，点右上角删除" android:textColor="@color/muted" android:textSize="14sp"/><HorizontalScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:scrollbars="none"><LinearLayout android:id="@+id/images" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal"/></HorizontalScrollView></FrameLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/addImages" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="＋ 从图库添加图片" app:cornerRadius="16dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="标题"><com.google.android.material.textfield.TextInputEditText android:id="@+id/titleInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="80"/></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="分享今天的亲子共读故事"><com.google.android.material.textfield.TextInputEditText android:id="@+id/contentInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:maxLength="2000" android:minLines="8"/></com.google.android.material.textfield.TextInputLayout>
    </LinearLayout></ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/publish" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="立即发布" android:textSize="16sp" app:cornerRadius="18dp"/>
</LinearLayout>
