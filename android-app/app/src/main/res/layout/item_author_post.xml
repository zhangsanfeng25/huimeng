        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/muted" android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
