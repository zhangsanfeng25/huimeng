<?xml version="1.0" encoding="utf-8"?>
<com.huimeng.bookshop.ui.PullRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/milk_white" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/muted" android:textSize="13sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="新增" app:cornerRadius="15dp" />
        </LinearLayout>
        <EditText android:id="@+id/searchQuery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:background="@drawable/bg_search" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:hint="搜索名称或编号" android:contentDescription="搜索商品或订单" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
            <Spinner android:id="@+id/statusFilter" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_search" android:paddingHorizontal="8dp" android:contentDescription="状态筛选" />
            <Spinner android:id="@+id/categoryFilter" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_search" android:paddingHorizontal="8dp" android:contentDescription="分类筛选" />
            <com.google.android.material.button.MaterialButton android:id="@+id/clearFilters" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:text="重置" />
        </LinearLayout>
        <TextView android:id="@+id/resultCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="12sp" />
        <ProgressBar android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:indeterminateTint="@color/cool_green" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:gravity="center" android:text="暂无数据" android:textColor="@color/muted" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" />
    </LinearLayout>
</com.huimeng.bookshop.ui.PullRefreshLayout>
