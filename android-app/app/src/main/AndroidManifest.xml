<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".HuiMengApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/local_backup_rules"
        android:dataExtractionRules="@xml/local_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.HuiMeng"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">

        <activity android:name=".ui.SearchActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ServiceActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.CategoriesActivity" android:exported="false" />
        <activity android:name=".ui.RatingsActivity" android:exported="false" />
        <activity android:name=".ui.MerchantApplicationActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.UserProfileActivity" android:exported="false" />
        <activity android:name=".ui.NotificationDetailActivity" android:exported="false" />
        <activity android:name=".ui.NotificationsActivity" android:exported="false" />
        <activity android:name=".ui.PaymentActivity" android:exported="false" />
        <activity android:name=".ui.PaymentSuccessActivity" android:exported="false" />
        <activity android:name=".ui.MerchantOrderDetailActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.SyncStatusActivity" android:exported="false" />
        <activity android:name=".ui.RoleSwitchActivity" android:exported="false" />
        <activity android:name=".ui.ManageProductActivity" android:exported="false" />
        <activity android:name=".ui.EditAccountActivity" android:exported="false" />
        <activity android:name=".ui.AddressesActivity" android:exported="false" />
        <activity android:name=".ui.RatingActivity" android:exported="false" />
        <activity android:name=".ui.OrderDetailActivity" android:exported="false" />
        <activity android:name=".ui.OrdersActivity" android:exported="false" />
        <activity android:name=".ui.ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".ui.RegisterActivity" android:exported="false" android:theme="@style/Theme.HuiMeng.ForestLogin" />
        <activity android:name=".ui.AddProductActivity" android:exported="false" />
        <activity android:name=".ui.AddAddressActivity" android:exported="false" />
        <activity android:name=".ui.CheckoutActivity" android:exported="false" />
        <activity android:name=".ui.CropImageActivity" android:exported="false" />
        <activity android:name=".ui.PublishPostActivity" android:exported="false" />
        <activity android:name=".ui.CommunityDetailActivity" android:exported="false" />
        <activity android:name=".ui.DataListActivity" android:exported="false" />
        <activity android:name=".ui.CartActivity" android:exported="false" />
        <activity android:name=".ui.ProductDetailActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.LoginActivity" android:exported="false" android:theme="@style/Theme.HuiMeng.ForestLogin" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.HuiMeng.Welcome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
